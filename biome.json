{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": ["src/soup/**", "tests/**", "*.json", "*.mts", "playwright.config.ts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "single" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "useReactFunctionComponentDefinition": {
          "level": "error",
          "options": { "namedComponents": "arrowFunction" }
        }
      }
    },
    "domains": { "react": "recommended" }
  }
}
